# General Settings
PROJECT_NAME=ScribeX
ENVIRONMENT=development

RAW_AUDIO_PATH=./data/captured_audio/

# Path to raw transcription (input)
RAW_TRANSCRIPT_PATH=./data/raw_transcript/

# Path to formatted transcript (output)
FORMATTED_TRANSCRIPT_PATH=./data/formatted_transcript/

# Audio settings
SOAP_NOTES_PATH=./data/SOAP_NOTES/


# Whisper / Speech-to-Text (STT)
WHISPER_MODEL_SIZE=medium
WHISPER_LANGUAGE=en

# PyAnnote / Diarization (if used)
HF_TOKEN=your_huggingface_token_here
PYANNOTE_MODEL=pyannote/speaker-diarization

# OpenAI (if GPT-based SOAP note generation used)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/scribex.log

# Output directories
OUTPUT_DIR=./output
TEMP_DIR=./temp